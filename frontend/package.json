{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "api:dump": "node scripts/dump-openapi.mjs",
    "gen:api": "npm run api:dump && openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false",
    "check:api": "npm run api:dump && openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable false --check"
  },
  "dependencies": {
    "katex": "0.19.1",
    "lucide-react": "1.72.0",
    "mathlive": "0.111.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}
