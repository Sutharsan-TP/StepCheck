# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Secret for signing guided-correction progress tokens (set a long random value in production;
# if empty, a random per-process secret is used and tokens stop working after a restart)
PROGRESS_TOKEN_SECRET=

# OpenRouter (handwriting transcription and explanations only - never used to judge correctness).
# Without a key, /transcribe returns 503 AI_UNAVAILABLE and /explain falls back to
# deterministic template explanations. Choose models you have tested for vision/JSON output.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_TEXT_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_APP_TITLE=StepCheck
OPENROUTER_APP_URL=
